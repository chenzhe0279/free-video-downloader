# ===== AI 视频总结（DeepSeek）=====
# 复制本文件为 backend/.env 后填入真实 Key；.env 已被 .gitignore 忽略。
VDS_DEEPSEEK_API_KEY=
VDS_DEEPSEEK_BASE_URL=https://api.deepseek.com
VDS_DEEPSEEK_MODEL=deepseek-flash

# 功能开关与限制
VDS_SUMMARY_ENABLED=true
VDS_SUMMARY_MAX_DURATION_SECONDS=7200
VDS_SUMMARY_DAILY_LIMIT_PER_IP=3
VDS_SUMMARY_RATE_LIMIT_PER_MINUTE=5
VDS_SUMMARY_MAX_CONCURRENT=2
VDS_SUMMARY_MAX_CONCURRENT_PER_IP=1

# 任务与缓存
VDS_SUMMARY_TTL_SECONDS=1800
VDS_SUMMARY_CACHE_TTL_SECONDS=21600
VDS_SUMMARY_CACHE_MAX_ENTRIES=50
VDS_SUMMARY_PROMPT_VERSION=v2

# 语音识别（官方单次上限 120 秒；默认 60 秒换取 1 分钟级时间戳）
VDS_SUMMARY_ASR_CHUNK_SECONDS=60
VDS_SUMMARY_ASR_CONCURRENCY=4
VDS_SUMMARY_MAX_AUDIO_BYTES=524288000

# 保护与成本估算
VDS_SUMMARY_MAX_TRANSCRIPT_CHARS=200000
VDS_SUMMARY_REQUEST_TIMEOUT_SECONDS=180
VDS_SUMMARY_ASR_PRICE_PER_HOUR_CNY=0.78
VDS_SUMMARY_THINKING_ENABLED=false

# 总结流（SSE）：前端不展示进度条；未完成只推状态，完成后按块打出 Markdown
VDS_SUMMARY_STREAM_POLL_SECONDS=0.8
VDS_SUMMARY_STREAM_CHUNK_CHARS=48
VDS_SUMMARY_STREAM_INTERVAL_MS=35

# ===== 视频内 AI 问答 =====
VDS_QA_ENABLED=true
VDS_QA_RATE_LIMIT_PER_MINUTE=10
VDS_QA_DAILY_LIMIT_PER_IP=30
VDS_QA_MAX_QUESTION_CHARS=500
VDS_QA_MAX_HISTORY_MESSAGES=6
VDS_QA_MAX_ANSWER_TOKENS=1200
VDS_QA_GATE_MAX_TOKENS=120
VDS_QA_MATERIAL_MAX_CHARS=12000
VDS_QA_ANSWER_TEMPERATURE=0.3
